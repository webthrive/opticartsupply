{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/tips-techniques",
      "destination": "/buying-guides",
      "permanent": true
    },
    {
      "source": "/tips-techniques/",
      "destination": "/buying-guides/",
      "permanent": true
    },
    {
      "source": "/tips-techniques/:path*",
      "destination": "/buying-guides/:path*",
      "permanent": true
    }
  ]
}
